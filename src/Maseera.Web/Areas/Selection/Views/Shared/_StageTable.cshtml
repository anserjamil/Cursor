@model StageViewModel
@{
    var state = Model.State;
    var group = Model.Page.Pills.FirstOrDefault(p => p.PillCode == Model.ActivePill);
}

<div data-table
     data-cycle-stage-id="@state.CycleStageId"
     data-screen-code="@state.ScreenCode"
     data-active-pill="@Model.ActivePill"
     data-sort-by="@Model.SortBy"
     data-sort-dir="@Model.SortDir"
     data-filters="@Model.FilterJson"
     data-compare-max="6"
     data-column-values-url="@Url.Action("ColumnValues")"
     data-save-view-url="@Url.Action("SaveView", "RosterFields", new { area = "Config" })"
     data-reset-view-url="@Url.Action("ResetView", "RosterFields", new { area = "Config" })">

    @* Two tiers: the title and count, then the tools. *@
    <div class="ms-toolbar ms-toolbar--tier1">
        <h2>Candidates</h2>
        <span class="ms-num ms-toolbar__count">@Model.Page.Totals.PoolCount.ToString("N0")</span>

        <span class="ms-topbar__spacer"></span>

        <div class="ms-segmented" role="group" aria-label="Views">
            <a class="ms-btn ms-btn--sm" asp-controller="Audit" asp-action="Index"
               asp-route-cycleStageId="@state.CycleStageId">Decision log</a>
            <a class="ms-btn ms-btn--sm" asp-controller="Compare" asp-action="Index"
               asp-route-cycleId="@state.CycleId" data-compare-selection>Compare</a>
        </div>

        @if (Model.CanWrite)
        {
            <button type="button" class="ms-btn ms-btn--primary ms-btn--sm"
                    data-modal-open="ms-modal"
                    data-src="@Url.Action("SearchPeople", new { cycleStageId = state.CycleStageId })">
                + Add people
            </button>
        }
    </div>

    <div class="ms-toolbar ms-toolbar--tier2">
        <input type="search" class="ms-input" data-table-search value="@Model.Search"
               placeholder="Name, number, department or job" aria-label="Search candidates" />

        <div class="ms-columns">
            <button type="button" class="ms-btn ms-btn--sm"
                    onclick="this.nextElementSibling.hidden = !this.nextElementSibling.hidden">
                Add Columns · <span class="ms-num">@Model.ActiveColumns.Count</span>
            </button>
            @await Html.PartialAsync("_ColumnPicker",
                (Model.Columns, Model.ActiveColumns, Viewer.RoleCode == "ADMIN"))
        </div>

        <button type="button" class="ms-btn ms-btn--sm" data-drawer-open="ms-drawer"
                data-src="@Url.Action("Suggestions", new { cycleStageId = state.CycleStageId })">
            Suggestions
        </button>

        <span class="ms-topbar__spacer"></span>

        <a class="ms-btn ms-btn--sm" data-export
           asp-controller="Audit" asp-action="Download" asp-route-cycleId="@state.CycleId">Export</a>
    </div>

    @* One row of pills, shared by Identify, Review and Calibration. *@
    @await Component.InvokeAsync("Funnel", new { pills = Model.Page.Pills, activePill = Model.ActivePill })

    <div class="ms-grouphead">
        <strong>@(group?.Caption ?? "Everybody in this stage")</strong>
        <span class="ms-num">@(group?.Cnt ?? Model.Page.Totals.PoolCount)</span>
        @if (group?.Tooltip is not null)
        {
            <span class="ms-table__recessive">@group.Tooltip</span>
        }
        <span class="ms-topbar__spacer"></span>
        <span class="ms-micro">Decided by @(state.PerformerName ?? "— not set")</span>
        <span class="ms-micro">@Model.ShownOfTotal</span>
    </div>

    @if (Model.Page.Problem is not null)
    {
        <div class="ms-refusal" role="alert">
            <div class="ms-refusal__title">This list could not be read</div>
            <p>@Model.Page.Problem</p>
        </div>
    }
    else if (Model.Page.Totals.PoolCount == 0)
    {
        @await Html.PartialAsync("_EmptyState",
            ("Nobody is in this stage yet",
             "The pool was resolved to nobody in the organisations you can see, or nobody has been added here yet.",
             (string?)null, (string?)null))
    }
    else if (Model.TooManyToDraw)
    {
        <div class="ms-refusal">
            <div class="ms-refusal__title">Too many rows to draw</div>
            <p>
                There are @Model.Page.Totals.TotalRows.ToString("N0") rows in this view. Narrow it
                with the funnel or a column filter, or export it and work on it there.
            </p>
        </div>
    }
    else
    {
        <div class="ms-bulkbar" data-bulk-bar hidden>
            <span data-bulk-count></span>
            <span class="ms-topbar__spacer"></span>
            @if (Model.CanWrite)
            {
                <button type="button" class="ms-btn ms-btn--sm" data-bulk-needs-selection
                        data-bulk-action="@Url.Action("Decide")" data-argcyclestageid="@state.CycleStageId"
                        data-argdecisioncode="NOMINATED" data-ok-message="Nominated.">Nominate</button>
                <button type="button" class="ms-btn ms-btn--sm" data-bulk-needs-selection
                        data-bulk-action="@Url.Action("Decide")" data-argcyclestageid="@state.CycleStageId"
                        data-argdecisioncode="WATCH" data-ok-message="Moved to the watch list.">Watch</button>
                <button type="button" class="ms-btn ms-btn--sm ms-btn--danger" data-bulk-needs-selection
                        data-bulk-action="@Url.Action("Decide")" data-argcyclestageid="@state.CycleStageId"
                        data-argdecisioncode="DROPPED" data-ok-message="Dropped.">Drop</button>
            }
        </div>

        <div class="ms-table-wrap">
            <table class="ms-table">
                <thead>
                    <tr>
                        <th class="is-sticky-col">
                            <input type="checkbox" data-select-all aria-label="Select everyone on this page" />
                            <button type="button" class="ms-colfilter" data-sort="FullName">Name</button>
                        </th>
                        <th><button type="button" class="ms-colfilter" data-sort="PersonnelNo">Personnel No</button></th>
                        <th><button type="button" class="ms-colfilter" data-sort="OrgName">Organisation</button></th>
                        <th><button type="button" class="ms-colfilter" data-sort="JobTitle">Job</button></th>
                        <th>Source</th>
                        <th>Decision</th>
                        @foreach (var column in Model.ActiveColumns)
                        {
                            var meta = Model.Columns.FirstOrDefault(c => c.ColumnName == column);
                            <th>
                                <button type="button" class="ms-colfilter" data-column-filter data-column="@column">
                                    @(meta?.Caption ?? column)
                                </button>
                            </th>
                        }
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Page.Rows)
                {
                    var personnelNo = row["PersonnelNo"]?.ToString() ?? string.Empty;
                    <tr data-person-row="@personnelNo">
                        <td class="is-sticky-col">
                            <input type="checkbox" data-row-select value="@personnelNo"
                                   aria-label="Select @row["FullName"]" />
                            <a asp-controller="Profile" asp-action="Index"
                               asp-route-personnelNo="@personnelNo" asp-route-cycleId="@state.CycleId">
                                @row["FullName"]
                            </a>
                        </td>
                        <td><ms-code>@personnelNo</ms-code></td>
                        <td>@row["OrgName"]</td>
                        <td>@row["JobTitle"]</td>
                        <td>
                            @* The source tag persists through every stage. *@
                            <span class="ms-tag" title="How this person came to be in the pool">@row["SourceName"]</span>
                            @if (row.TryGetValue("AlsoInCount", out var also) && Convert.ToInt32(also ?? 0) > 0)
                            {
                                <span class="ms-tag" title="Also eligible in another live cycle">also in @also</span>
                            }
                        </td>
                        <td>
                            @if (row["DecisionName"] is not null)
                            {
                                <state-chip role="@row["DecisionRole"]?.ToString()" label="@row["DecisionName"]?.ToString()"></state-chip>
                            }
                            else
                            {
                                <span class="ms-table__recessive">No decision</span>
                            }
                        </td>
                        @foreach (var column in Model.ActiveColumns)
                        {
                            <td>@(row.TryGetValue(column, out var value) ? value : null)</td>
                        }
                        <td>
                            @if (Model.CanWrite)
                            {
                                @await Html.PartialAsync("_RowActions", (state, personnelNo, row["BoxCode"]?.ToString()))
                            }
                            else
                            {
                                @* A read-only viewer sees the status, not a control that would fail. *@
                                <span class="ms-tag">@(row["DecisionName"] ?? "No decision")</span>
                            }

                            <button type="button" class="ms-btn ms-btn--sm ms-btn--ghost"
                                    data-drawer-open="ms-drawer"
                                    data-src="@Url.Action("Focus", new { cycleStageId = state.CycleStageId, personnelNo })">
                                Focus
                            </button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @await Html.PartialAsync("_Pager",
            (Model.PageNo,
             Model.Page.Totals.PageSize <= 0 ? 1 : (int)Math.Ceiling(Model.Page.Totals.TotalRows / (double)Model.Page.Totals.PageSize),
             Model.Page.Totals.TotalRows,
             Model.Page.Rows.Count))
    }
</div>
