<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>


  <!--
    FluentAssertions 8 moved to the Xceed licence, which needs a paid subscription for
    commercial use. This is an internal tool for a company, so the tests stay on 7.2,
    the last Apache-2.0 release. Do not let a restore quietly float this forward.
  -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="FluentAssertions" Version="[7.2.0]" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Maseera.Core\Maseera.Core.csproj" />
    <ProjectReference Include="..\..\src\Maseera.Data\Maseera.Data.csproj" />
    <ProjectReference Include="..\..\src\Maseera.Sql\Maseera.Sql.csproj" />
  </ItemGroup>

</Project>
